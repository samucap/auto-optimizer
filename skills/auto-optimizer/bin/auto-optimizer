#!/usr/bin/env bash
# auto-optimizer CLI — all Python via uv run
set -euo pipefail

# Resolve real path even when invoked via ~/.local/bin symlink
_SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$_SOURCE" ]]; do
  _DIR="$(cd "$(dirname "$_SOURCE")" && pwd)"
  _SOURCE="$(readlink "$_SOURCE")"
  [[ "$_SOURCE" != /* ]] && _SOURCE="$_DIR/$_SOURCE"
done
BIN_DIR="$(cd "$(dirname "$_SOURCE")" && pwd)"
SKILL_DIR="$(cd "$BIN_DIR/.." && pwd)"
SCRIPTS="$SKILL_DIR/scripts"
REQ="$SCRIPTS/requirements.txt"

die() { echo "auto-optimizer: $*" >&2; exit 1; }

need_uv() {
  if ! command -v uv >/dev/null 2>&1; then
    die "uv not found. Install: curl -LsSf https://astral.sh/uv/install.sh | sh"
  fi
}

uv_py() {
  need_uv
  # latest compatible interpreter; requirements pulled on demand
  uv run --with-requirements "$REQ" python "$@"
}

cmd="${1:-}"
shift || true

case "$cmd" in
  ""|-h|--help|help)
    cat <<'EOF'
auto-optimizer — modular multi-subagent optimization loop

Usage:
  auto-optimizer init [--local] [--with-self-test] [--force]
  auto-optimizer once [--module NAME] [--local] [--live] [--dry-run] [--force-fail KIND]
  auto-optimizer start [--module NAME] [--max-cycles N] [--interval DUR] [--no-tmux] [--local] [--live]
  auto-optimizer stop [--local]
  auto-optimizer status [--local]
  auto-optimizer self-test [--live]
  auto-optimizer eval --candidate-dir DIR [--module NAME] ...

Python entrypoints use: uv run --with-requirements <skill>/scripts/requirements.txt
EOF
    exit 0
    ;;
  init)
    LOCAL=""; WITH_ST=""; FORCE=""
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --local) LOCAL="--local" ;;
        --with-self-test) WITH_ST="--with-self-test" ;;
        --force) FORCE="--force" ;;
        *) die "unknown init arg: $1" ;;
      esac
      shift
    done
    uv_py "$SCRIPTS/cli_init.py" $LOCAL $WITH_ST $FORCE
    ;;
  once)
    # Default offline unless user passes --live
    if [[ "$*" == *"--live"* ]]; then
      uv_py "$SCRIPTS/run_cycle.py" "$@"
    else
      uv_py "$SCRIPTS/run_cycle.py" --offline "$@"
    fi
    ;;
  start)
    exec "$BIN_DIR/start-loop.sh" "$@"
    ;;
  stop)
    LOCAL=""
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --local) LOCAL="--local" ;;
        *) die "unknown stop arg: $1" ;;
      esac
      shift
    done
    uv_py "$SCRIPTS/cli_stop.py" $LOCAL
    ;;
  status)
    LOCAL=""
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --local) LOCAL="--local" ;;
        *) die "unknown status arg: $1" ;;
      esac
      shift
    done
    uv_py "$SCRIPTS/cli_status.py" $LOCAL
    ;;
  self-test)
    uv_py "$SCRIPTS/self_test.py" "$@"
    ;;
  eval)
    uv_py "$SCRIPTS/eval.py" "$@"
    ;;
  acp|orchestrator)
    uv_py "$SCRIPTS/acp-orchestrator.py" "$@"
    ;;
  *)
    die "unknown command: $cmd (try --help)"
    ;;
esac
